rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && getUserData().role != null ? getUserData().role : 'citizen';
    }

    function isOfficialOrAdmin() {
      return getUserRole() == 'official' || getUserRole() == 'admin';
    }

    function isDepartmentHead() {
      return getUserRole() == 'department_head';
    }

    function isWorker() {
      return getUserRole() == 'worker';
    }

    // USERS collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Workers cannot modify authoritative profile fields (role, departmentId, department, employeeId)
      allow update: if isOfficialOrAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'departmentId', 'department', 'employeeId', 'maxTaskCapacity'])
      );
      allow delete: if isOfficialOrAdmin();
    }

    // REPORTS collection
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        isOfficialOrAdmin() ||
        (isDepartmentHead() && resource.data.departmentId == getUserData().departmentId) ||
        (isWorker() && (resource.data.assignedWorkerId == request.auth.uid || resource.data.departmentId == getUserData().departmentId)) ||
        (resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOfficialOrAdmin() || (
        isDepartmentHead() && resource.data.departmentId == getUserData().departmentId
      ) || (
        isWorker() && resource.data.assignedWorkerId == request.auth.uid
      );
      allow delete: if isOfficialOrAdmin();
    }

    // CONTRACTORS collection
    match /contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOrAdmin() || isDepartmentHead();
    }

    // NOTIFICATIONS collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == null || resource.data.userId == request.auth.uid || isOfficialOrAdmin()
      );
      allow write: if isOfficialOrAdmin() || isDepartmentHead();
    }

    // CIVIC SERVICES collection
    match /civic_services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOfficialOrAdmin();
    }
  }
}
